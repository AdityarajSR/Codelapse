# Copy this file to .env.local and fill in a key.
# .env.local is git-ignored. These values stay on the server — they are
# never sent to the browser.

# FREE: get a key at https://aistudio.google.com/apikey (no credit card).
# Powers the "Ask AI" tab.
GEMINI_API_KEY=

# ---- optional --------------------------------------------------------------

# Which Gemini model answers (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Backups: every provider with a key is used, in order Gemini → Groq →
# Claude — when one is out of quota the next answers. Force one with AI_PROVIDER.
# GROQ_API_KEY=          # free tier at https://console.groq.com
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=     # paid, https://console.anthropic.com
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=gemini
